# JARVIS configuration
# Copy this file to `.env` and adjust. `.env` is git-ignored: NEVER commit secrets.

# --- Core behaviour ---------------------------------------------------------
# Backend: auto | simulated | pyautogui
#   auto       - use the real GUI backend when available, otherwise simulated
#   simulated  - virtual desktop (safe testing / headless machines / CI)
#   pyautogui  - force the real backend (requires a display + `pip install jarvis[computer]`)
JARVIS_BACKEND=auto

# Highest risk level that executes WITHOUT asking the user: low | medium | high
#   low    (default) - read-only + app launching run automatically
#   medium           - file modifications also run automatically
#   high             - everything runs automatically (NOT recommended)
JARVIS_AUTO_APPROVE_RISK=low

# Extra retries after a failed/verified-failed action before asking the user.
JARVIS_MAX_RETRIES=2

# --- Safety / interrupts ----------------------------------------------------
# Emergency stop hotkey (requires `pip install jarvis[hotkey]`). Any "keyboard"
# library hotkey string works.
JARVIS_EMERGENCY_STOP_HOTKEY=ctrl+alt+j
JARVIS_EMERGENCY_HOTKEY_ENABLED=true

# --- Behaviour tuning -------------------------------------------------------
JARVIS_VERIFY_TIMEOUT=8
JARVIS_TYPING_INTERVAL=0.03
JARVIS_SEARCH_ENGINE=google

# Where JARVIS stores logs, task memory and screenshots.
JARVIS_DATA_DIR=~/.jarvis

# Logging level for the file log: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# Terminal commands JARVIS is allowed to run (comma separated). Anything else
# is refused, regardless of risk level.
JARVIS_ALLOWED_TERMINAL_COMMANDS=python,python3,pip,pip3,git,node,npm,tasklist,where,ls,which

# --- Voice (Phase 4 - not active yet) ---------------------------------------
JARVIS_VOICE_ENABLED=false
JARVIS_VOICE_RATE=1.0
JARVIS_VOICE_VOLUME=1.0

# --- AI provider (Phase 2 - not active yet; rule-based brain is used now) ---
# JARVIS_AI_PROVIDER=none
# JARVIS_OPENAI_API_KEY=...        # or set OPENAI_API_KEY in the environment
